# The status page pings this endpoint to show live health of the BAI control
# plane. Override per Cloudflare Pages environment.
NEXT_PUBLIC_API_BASE=https://bai-control-plane-staging.fly.dev

# Build-time visitor collection: none | plausible | cloudflare.
# Unset preserves legacy Plausible if its domain is set, otherwise no analytics.
# One selection controls collector, generated CSP and rendered privacy copy.
# Scripts run only on https://doyel-labs.com public pages, never preview/local/admin.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Public beacon site_token, NOT the API secret, site_tag, or zone ID.
# Cloudflare mode fails the build unless this is a 32-character lowercase hex token.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Private dashboard: runtime Pages bindings, NOT NEXT_PUBLIC_ build variables.
# Absent/false by default. This flag enables reads only, never collection.
ANALYTICS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=<analytics-application-aud>
ANALYTICS_ALLOWED_EMAIL=<exact-owner-email>
CF_ACCOUNT_ID=<account-id>
CF_WEB_ANALYTICS_SITE_TAG=<web-analytics-site-tag-not-beacon-token>
# Encrypted Production Pages secret only; never copy real values into this file.
CF_ANALYTICS_API_TOKEN=<account-analytics-read-token>
# CONTACT_KV is an existing Pages KV binding, not an environment string.
