# Build-time (public) variables — set in Cloudflare Pages → Settings → Environment variables.

# Plausible Analytics domain. Leave unset to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=doyel-labs.com

# Cloudflare Turnstile site key (client widget). The matching secret,
# TURNSTILE_SECRET_KEY, is an encrypted Pages secret, never in this file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side secrets (Pages Functions) — set as ENCRYPTED in the dashboard:
#   RESEND_API_KEY        sending-access scope only
#   TURNSTILE_SECRET_KEY  server-side verify secret
# Plain-text function variables:
#   RESEND_FROM           e.g. "Doyel Labs Website <noreply@doyel-labs.com>"
#   CONTACT_TO            default support@doyel-labs.com
# Bindings (Pages → Settings → Functions):
#   RATE_LIMITER          Rate Limiting binding, 5 requests / 300 s (preferred)
#   CONTACT_KV            KV namespace (fallback if no Rate Limiting binding)
# In production (branch "master") the function refuses to run without a
# Turnstile secret and one rate-limit binding. See functions/api/contact.ts.

# ── Visitor analytics (public, build-time) ──────────────────────────────
# Choose exactly one provider. "cloudflare" is what production runs.
NEXT_PUBLIC_ANALYTICS_PROVIDER=cloudflare
# Cloudflare Web Analytics site token (32 hex chars, from the dashboard).
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# First-party approximate-location counts (requires provider=cloudflare).
NEXT_PUBLIC_LOCATION_ANALYTICS_ENABLED=true

# ── Owner analytics dashboard (Pages Function env) ──────────────────────
#   ANALYTICS_ENABLED=true            enables dashboard reads
#   LOCATION_ANALYTICS_ENABLED=true   enables the location ingest endpoint
#   LOCATION_DB                       D1 binding → database "website-location-analytics"
#   CF_ACCESS_TEAM_DOMAIN             <team>.cloudflareaccess.com
#   CF_ACCESS_AUD                     Access application audience tag (64 hex)
#   ANALYTICS_ALLOWED_EMAIL           the one email allowed to view /admin/analytics/
#   CF_ACCOUNT_ID, CF_ANALYTICS_API_TOKEN, CF_WEB_ANALYTICS_SITE_TAG   for the Web Analytics GraphQL reads
# The privacy policy and /security/ describe whatever these are set to.
