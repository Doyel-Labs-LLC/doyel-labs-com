# Cloudflare Pages custom response headers.
# Applied on top of Cloudflare's platform defaults. Marketing surface stays
# free of third-party marketing pixels, session-replay tools, and cookie-set
# network I/O. The post-export build step replaces analytics placeholders
# with the one selected provider's hosts (or no hosts when disabled).
#
# CSP notes:
#   - Analytics uses an external script only; the existing inline allowance
#     is retained for the public Next.js export, not for analytics injection.
#   - `connect-src` includes the BAI control plane hosts (queried by
#     `/status` from the viewer's browser) and the selected analytics endpoint.
#   - `style-src` retains `'unsafe-inline'` because Next.js emits inline
#     styles for critical CSS in a static export. This does not weaken the
#     script surface.
#   - `frame-ancestors 'none'` + `X-Frame-Options: DENY` — the site never
#     accepts being framed.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' mailto: tel:; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' __ANALYTICS_SCRIPT_SRC__ https://challenges.cloudflare.com; script-src-elem 'self' 'unsafe-inline' __ANALYTICS_SCRIPT_SRC__ https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://bai-control-plane-staging.fly.dev https://bai-control-plane.fly.dev __ANALYTICS_CONNECT_SRC__ https://challenges.cloudflare.com; media-src 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Robots-Tag: index, follow

# Cache static assets aggressively
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# security.txt is served directly at /.well-known/security.txt
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Next.js emits the Open Graph image at /opengraph-image with no file
# extension, so we force image/png here.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# Per-section OG cards live at /<section>/opengraph-image (also no file
# extension). The splat matches across path segments, so it covers both
# /services/opengraph-image and /services/custom-software/opengraph-image.
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
