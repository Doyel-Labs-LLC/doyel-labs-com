# Cloudflare Pages custom response headers.
# Applied on top of Cloudflare's platform defaults. Marketing surface stays
# free of third-party marketing pixels, session-replay tools, and cookie-set
# network I/O. Plausible is the only third-party host allowed, and only when
# `NEXT_PUBLIC_PLAUSIBLE_DOMAIN` is set at build time.
#
# CSP notes:
#   - `script-src` allows Plausible from `plausible.io`. No `'unsafe-inline'`
#     because analytics injection uses an external script only.
#   - `connect-src` includes the BAI control plane hosts (queried by
#     `/status` from the viewer's browser) and Plausible's event endpoint.
#   - `style-src` retains `'unsafe-inline'` because Next.js emits inline
#     styles for critical CSS in a static export. This does not weaken the
#     script surface.
#   - `frame-ancestors 'none'` + `X-Frame-Options: DENY` — the site never
#     accepts being framed.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' mailto: tel:; frame-ancestors 'none'; script-src 'self' https://plausible.io; script-src-elem 'self' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://bai-control-plane-staging.fly.dev https://bai-control-plane.fly.dev https://plausible.io; media-src 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests
  X-Robots-Tag: index, follow

# Cache static assets aggressively
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# security.txt is served directly at /.well-known/security.txt
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
