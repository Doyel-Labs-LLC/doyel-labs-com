# Cloudflare Pages redirect table (evaluated before static files).
#
# v9 consolidated the site to eight pages. Every retired route 301s to
# the page that now holds its content. Keep this list; old links live on
# in search results and inboxes for years.

# ── Services → the two lanes ──────────────────────────────────
/services                          /websites/                301
/services/                         /websites/                301
/services/websites                 /websites/                301
/services/websites/*               /websites/                301
/services/custom-software          /software/                301
/services/custom-software/*        /software/                301
/services/payroll                  /software/                301
/services/payroll/*                /software/                301

# ── Pricing / FAQ / support → websites + how-we-work ──────────
/pricing                           /websites/#pricing        301
/pricing/*                         /websites/#pricing        301
/faq                               /websites/#faq            301
/faq/*                             /websites/#faq            301
/support                           /how-we-work/             301
/support/*                         /how-we-work/             301
/start                             /how-we-work/             301
/start/*                           /how-we-work/             301
/docs                              /how-we-work/             301
/docs/payroll                      /software/                301
/docs/payroll/*                    /software/                301
/docs/websites                     /websites/                301
/docs/websites/*                   /websites/                301
/docs/*                            /how-we-work/             301

# ── Company pages → about ─────────────────────────────────────
/company                           /about/                   301
/company/*                         /about/                   301
/founder                           /about/                   301
/founder/*                         /about/                   301
/press                             /about/                   301
/press/*                           /about/                   301
/uses                              /about/                   301
/uses/*                            /about/                   301
/changelog                         /about/                   301
