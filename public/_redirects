# Cloudflare Pages redirect table.
#
# The previous site was branded as "BAI by Doyel Labs" and had /download as a
# top-level BAI-only surface. All BAI-specific routes now live under
# /products/ (with dedicated /legal/bai/* pages for the legal docs submitted
# to Alpaca). ConnectionLoop lives on the same products page.
#
# Pricing is now a quote-based section of Services. Redirect only the
# overview, never a wildcard to BAI. The old pricing-to-products bug must
# not return.
#
# The `/start/`, `/reviews/`, and `/case-studies/steadfast/` pages were
# consolidated into `/contact/` and `/work/` respectively — they had too
# little distinct content to earn their own routes and were adding
# indexation noise on a name-search where the AI Overview is finally
# picking up "custom software studio" as the primary identity.

# ── Old BAI-brand marketing routes ─────────────────────────────
/download            /products/#bai                 301
/download/*          /products/#bai                 301

# ── Old programs tree → products page ───────────────────────────
/programs            /products/                     301
/programs/           /products/                     301
/programs/bai        /products/#bai                 301
/programs/bai/       /products/#bai                 301
/programs/connectionloop        /products/#connectionloop  301
/programs/connectionloop/       /products/#connectionloop  301

# ── Old per-program docs → products page ────────────────────────
/docs/bai            /products/#bai                 301
/docs/bai/           /products/#bai                 301
/docs/connectionloop /products/#connectionloop      301
/docs/connectionloop/ /products/#connectionloop     301

# ── Consolidated content ────────────────────────────────────────
/pricing             /services/#pricing             301
/pricing/            /services/#pricing             301
/how-we-work         /services/#process             301
/how-we-work/        /services/#process             301
/founder             /company/                      301
/founder/            /company/                      301
/industries          /services/#industries          301
/industries/         /services/#industries          301
/start               /contact/                      301
/start/              /contact/                      301
/reviews             /work/                         301
/reviews/            /work/                         301
/case-studies                    /work/             301
/case-studies/                   /work/             301
/case-studies/steadfast          /work/             301
/case-studies/steadfast/         /work/             301

# ── Legacy support / recovery routes ────────────────────────────
/community           /support/                      301
/community/*         /support/                      301
