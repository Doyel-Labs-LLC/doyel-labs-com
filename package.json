{
  "name": "doyel-labs-site",
  "version": "0.1.0",
  "private": true,
  "description": "doyel-labs.com — the company site for Doyel Labs LLC (Casper, Wyoming). Websites and custom software, built by a person you can call.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/csp-hashes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "npm run check && wrangler pages deploy out --project-name=website --branch=master"
  },
  "dependencies": {
    "marked": "^14.1.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.15.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
